{
  "name": "puckling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gallery": "bun scripts/gallery.ts",
    "sim": "node scripts/sim.mjs",
    "test": "bun test src scripts/feeder",
    "check": "tsc --noEmit",
    "build:firmware": "gea build --board puck",
    "flash": "gea flash --board puck",
    "monitor": "gea monitor --board puck",
    "screenshot": "gea screenshot --board puck",
    "sim:screenshot": "node scripts/sim-screenshot.mjs",
    "feed": "bun scripts/feeder/main.ts",
    "feed:ble": "bun scripts/feeder/main.ts --watch 5 --ble",
    "feed:pair": "bun scripts/feeder/main.ts --pair --ble",
    "feed:report": "bun scripts/feeder/main.ts --report --days 7"
  },
  "dependencies": {
    "@geajs/core": "^1.3.0",
    "@geastack/core": "^0.1.40",
    "@geastack/targets": "^0.1.101"
  },
  "devDependencies": {
    "@geastack/cli": "^0.1.109",
    "@geastack/simulator": "^0.1.15",
    "playwright": "1.65.1",
    "typescript": "^5.9.3",
    "vite": "8.3.8"
  },
  "gea": {
    "id": "puckling",
    "name": "Puckling",
    "entry": "src/index.tsx",
    "webPreload": [{ "source": "feed", "target": "/sim" }],
    "targets": {
      "web": true,
      "esp32": true,
      "rp2350": false,
      "geaos": false,
      "macos": false,
      "ios": false,
      "android": false,
      "windows": false
    }
  },
  "license": "MIT"
}
